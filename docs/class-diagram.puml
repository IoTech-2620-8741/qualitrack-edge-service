@startuml QualiTrack Edge Service - Class Diagram

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam monochrome false
skinparam shadowing false
left to right direction

package "IAM Bounded Context" #FFEBDE {
  package "domain" as iam_domain #FFF2E8 {
    class Device {
      +device_id: str
      +credential: ApiCredential
      +device_type: DeviceType
      +created_at: datetime
      +revoked_at: datetime | None
      +register(device_id, api_key, device_type, created_at=None): Device
      +authenticate(api_key): bool
      +revoke(at=None): Device
      +rotate_api_key(new_api_key): Device
    }

    class ApiCredential {
      -_digest: bytes
      -_salt: bytes | None
      -_iterations: int | None
      +generate_secret(): str
      +create(secret): ApiCredential
      +from_encoded(encoded): ApiCredential
      +matches(secret): bool
      +encode(): str
    }

    enum "DeviceType" as IamDeviceType {
      ENVIRONMENTAL_DEVICE
      CONTAINER_MONITOR
    }

    interface "DeviceRepository\n<<Protocol>>" as IDeviceRepository {
      +find_by_device_id(device_id): Device | None
      +find_all(): list[Device]
      +add(device): Device
      +save(device): Device
      +get_or_create_test_device(device_id, api_key, device_type): Device
    }
  }

  package "application" as iam_application #FFE6D5 {
    class AuthApplicationService {
      +__init__(device_repository=None)
      +authenticated_device(device_id, api_key): Device | None
      +register_device(device_id, device_type): IssuedApiKey
      +revoke_device(device_id): Device
      +rotate_api_key(device_id): IssuedApiKey
      +list_devices(): list[Device]
      +get_or_create_test_device(device_id, api_key, device_type): Device
    }

    class IssuedApiKey {
      +device: Device
      +api_key: str
    }
  }

  package "infrastructure" as iam_infrastructure #FFDAC1 {
    class "Device" as DeviceModel <<Peewee Model>> {
      +device_id: CharField <<PK>>
      +credential_verifier: CharField
      +device_type: CharField
      +created_at: DateTimeField
      +revoked_at: DateTimeField | None
    }

    class "DeviceRepository\n(implementation)" as DeviceRepositoryImpl
  }

  package "interfaces" as iam_interfaces #FFCEAE {
    class SignInRequest <<Pydantic Model>> {
      +device_id: str
    }

    class iam_api <<Flask Blueprint>> {
      +POST /api/v1/auth/sign-in
    }

    class devices_cli <<Flask command group>> {
      +register(device_id, device_type)
      +rotate-key(device_id)
      +revoke(device_id)
      +list()
    }
  }
}

package "Tracking Bounded Context" #DEEAFF {
  package "domain" as tracking_domain #E2F0FF {
    class ReportingDevice {
      +device_id: str
      +device_type: DeviceType
    }

    class TelemetryReading {
      +device_id: str
      +metric: Metric
      +value: float | None
      +text_value: str | None
      +measured_at: ObservationTime
      +profile_version: ProfileVersion | None
      +received_at: datetime
      +sync_status: SyncStatus
      +id: int | None
      +record(reporting_device, metric, reading, measured_at, profile_version, received_at): TelemetryReading
      +is_same_observation(other): bool
      +synchronized(status): TelemetryReading
    }

    class ActuationEvent {
      +device_id: str
      +action: ActuationAction
      +trigger_metric: Metric | None
      +trigger_state: EnvironmentalState | None
      +result: ActuationResult
      +occurred_at: ObservationTime
      +profile_version: ProfileVersion | None
      +received_at: datetime
      +sync_status: SyncStatus
      +id: int | None
      +record(reporting_device, action, trigger_metric, trigger_state, result, occurred_at, profile_version, received_at): ActuationEvent
      +is_same_observation(other): bool
      +synchronized(status): ActuationEvent
    }

    class EnvironmentalProfile {
      +device_id: str
      +version: ProfileVersion
      +thresholds: tuple[Threshold]
      +actuation_rules: tuple[ActuationRule]
      +cloud_updated_at: datetime | None
      +synced_at: datetime
    }

    class ObservationTime {
      +value: datetime
      +received(value, received_at): ObservationTime
    }

    class ProfileVersion {
      +value: int
      +from_optional(value): ProfileVersion | None
    }

    class Threshold {
      +metric: Metric
      +unit: str
      +normal_min: float | None
      +normal_max: float | None
      +critical_min: float | None
      +critical_max: float | None
    }

    class ActuationRule {
      +metric: Metric
      +state: EnvironmentalState
      +action: ActuationAction
    }

    enum Metric {
      AIR_QUALITY
      MOTION
      TEMPERATURE
      HUMIDITY
      LUMINOSITY
      RFID_TAG
      +device_type: DeviceType
      +has_thresholds: bool
    }

    enum SyncStatus {
      PENDING
      SYNCED
      REJECTED
    }

    class TelemetryConflict

    interface "TelemetryReadingRepository\n<<Protocol>>" as ITelemetryReadingRepository {
      +save_idempotently(readings): TelemetryReadingSaveResult
      +find_pending(after_id, limit, device_ids): list[TelemetryReading]
      +count_pending_outside(device_ids): int
      +save_sync_status(reading)
      +count_by_sync_status(): dict[SyncStatus, int]
    }

    interface "ActuationEventRepository\n<<Protocol>>" as IActuationEventRepository {
      +save_idempotently(event): ActuationEventSaveResult
      +find_pending(after_id, limit, device_ids): list[ActuationEvent]
      +count_pending_outside(device_ids): int
      +save_sync_status(event)
      +count_by_sync_status(): dict[SyncStatus, int]
    }

    interface "EnvironmentalProfileRepository\n<<Protocol>>" as IEnvironmentalProfileRepository {
      +find_by_device_id(device_id): EnvironmentalProfile | None
      +find_all(): list[EnvironmentalProfile]
      +replace_all(profiles)
    }
  }

  package "application" as tracking_application #D5E7FF {
    class TelemetryApplicationService {
      +__init__(iam_anti_corruption_layer, telemetry_reading_repository=None, actuation_event_repository=None, clock=None)
      +record_readings(device_id, api_key, device_type, measured_at, profile_version, values): TelemetryReadingSaveResult
      +record_actuation_event(device_id, api_key, action, trigger_metric, trigger_state, result, occurred_at, profile_version): ActuationEventSaveResult
    }

    class EnvironmentalProfileApplicationService {
      +__init__(iam_anti_corruption_layer, environmental_profile_repository=None)
      +configuration_for(device_id, api_key): NodeConfiguration
      +profiles(): list[EnvironmentalProfile]
    }

    class DeviceAuthenticationFailed
    class DeviceTypeNotAllowed
    class ConfigurationNotAvailable
  }

  package "integration" as tracking_integration #DCE8F5 {
    class IamAntiCorruptionLayer {
      +__init__(iam_authentication_service)
      +authenticated_reporting_device(device_id, credential): ReportingDevice | None
    }
  }

  package "infrastructure" as tracking_infrastructure #C9DFFF {
    class TelemetryReadingModel <<Peewee Model>>
    class ActuationEventModel <<Peewee Model>>
    class EnvironmentalProfileModel <<Peewee Model>>
    class "TelemetryReadingRepository\n(implementation)" as TelemetryReadingRepositoryImpl
    class "ActuationEventRepository\n(implementation)" as ActuationEventRepositoryImpl
    class "EnvironmentalProfileRepository\n(implementation)" as EnvironmentalProfileRepositoryImpl
  }

  package "interfaces" as tracking_interfaces #BCCEFF {
    class EnvironmentReadingRequest <<Pydantic Model>> {
      +device_id: str
      +measured_at: AwareDatetime
      +profile_version: int | None
      +air_quality: float | None
      +motion: bool | None
    }

    class ContainerReadingRequest <<Pydantic Model>> {
      +device_id: str
      +measured_at: AwareDatetime
      +profile_version: int | None
      +temperature: float | None
      +humidity: float | None
      +luminosity: float | None
      +rfid_tag: str | None
    }

    class ActuationEventRequest <<Pydantic Model>> {
      +device_id: str
      +action: ActuationAction
      +trigger_metric: Metric | None
      +trigger_state: EnvironmentalState | None
      +result: ActuationResult
      +occurred_at: AwareDatetime
      +profile_version: int | None
    }

    class tracking_api <<Flask Blueprint>> {
      +POST /api/v1/monitoring/environment-readings
      +POST /api/v1/monitoring/container-readings
      +POST /api/v1/control/actuation-events
      +GET /api/v1/configurations/{deviceId}
    }
  }
}

package "Sync Bounded Context" #F0E6FF {
  package "domain" as sync_domain #F6EEFF {
    class MonitoredDevice {
      +device_id: str
      +device_type: DeviceType
      +laboratory_id: int
      +environment_id: int | None
      +cloud_device_id: int
      +status: DeviceStatus
      +synced_at: datetime
      +is_in_environment: bool
    }

    interface "MonitoredDeviceRepository\n<<Protocol>>" as IMonitoredDeviceRepository {
      +find_by_device_id(device_id): MonitoredDevice | None
      +find_all(): list[MonitoredDevice]
      +replace_all(devices)
    }
  }

  package "application" as sync_application #EADBFF {
    class DeviceRegistryApplicationService {
      +__init__(registry_gateway, iam_anti_corruption_layer, monitored_device_repository)
      +synchronize_registry(): RegistrySynchronization
      +monitored_devices(): list[MonitoredDevice]
      +enroll_device(device_id, device_type): str
    }

    class ProfileSynchronizationApplicationService {
      +__init__(profile_gateway, monitored_device_repository, environmental_profile_repository)
      +synchronize_profiles(): list[EnvironmentalProfile]
    }

    class TelemetrySynchronizationApplicationService {
      +__init__(telemetry_gateway, monitored_device_repository, telemetry_reading_repository, actuation_event_repository, batch_size=100)
      +synchronize_pending(): dict[str, SynchronizationSummary]
      +pending_counts(): dict
      +purge(): int
    }

    interface "DeviceRegistryGateway\n<<Protocol>>" as IDeviceRegistryGateway {
      +fetch_devices(): list[MonitoredDevice]
    }

    interface "ProfileGateway\n<<Protocol>>" as IProfileGateway {
      +fetch_profile(device): EnvironmentalProfile | None
    }

    interface "TelemetryGateway\n<<Protocol>>" as ITelemetryGateway {
      +send_reading(device, reading): SyncStatus
      +send_actuation_event(device, event): SyncStatus
    }

    class CloudSynchronizationDisabled
    class DeviceEnrollmentNotAllowed
    class DeviceAlreadyEnrolled
  }

  package "integration" as sync_integration #E6DCF5 {
    class "IamAntiCorruptionLayer" as SyncIamAntiCorruptionLayer {
      +__init__(iam_authentication_service)
      +registered_device_ids(): set[str]
      +enroll_device(device_id, device_type): str
    }
  }

  package "infrastructure" as sync_infrastructure #DDC9FF {
    class MonitoredDeviceModel <<Peewee Model>>
    class "MonitoredDeviceRepository\n(implementation)" as MonitoredDeviceRepositoryImpl

    class CloudDeviceRegistryGateway {
      +fetch_devices(): list[MonitoredDevice]
    }

    class CloudProfileGateway {
      +fetch_profile(device): EnvironmentalProfile | None
    }

    class CloudTelemetryGateway {
      +send_reading(device, reading): SyncStatus
      +send_actuation_event(device, event): SyncStatus
    }
  }

  package "interfaces" as sync_interfaces #CEBCFF {
    class sync_api <<Flask Blueprint>> {
      +POST /api/v1/devices/enroll
    }

    class cloud_cli <<Flask command group>> {
      +sync()
      +devices()
      +profiles()
      +pending()
    }
  }
}

package "Shared Infrastructure" #E8FFE8 {
  class db <<SqliteDatabase>>

  class CloudSession {
    +__init__(base_url, device_id, api_key, http_client=None)
    +device_id: str
    +request(method, path, json=None): Response
  }

  class CloudSyncScheduler {
    +__init__(interval_seconds, tasks)
    +run_once(): dict[str, object]
    +start()
    +stop(timeout=None)
  }

  class CloudRequestError
}

class create_app {
  +create_app(): Flask
  +start_cloud_sync(app)
}

class wsgi <<Gunicorn entry point>>

Device --> ApiCredential
Device --> IamDeviceType
AuthApplicationService --> IDeviceRepository : depends on protocol
AuthApplicationService ..> Device : coordinates lifecycle
AuthApplicationService ..> IssuedApiKey : returns
DeviceRepositoryImpl ..|> IDeviceRepository
DeviceRepositoryImpl --> DeviceModel
iam_api --> SignInRequest : validates
iam_api --> AuthApplicationService : invokes
devices_cli --> AuthApplicationService : invokes

TelemetryReading --> ObservationTime
TelemetryReading --> ProfileVersion
TelemetryReading --> Metric
TelemetryReading --> SyncStatus
ActuationEvent --> ObservationTime
ActuationEvent --> SyncStatus
EnvironmentalProfile --> Threshold
EnvironmentalProfile --> ActuationRule
EnvironmentalProfile --> ProfileVersion

IamAntiCorruptionLayer --> AuthApplicationService : authenticates through
IamAntiCorruptionLayer ..> ReportingDevice : translates result

TelemetryApplicationService --> IamAntiCorruptionLayer
TelemetryApplicationService --> ITelemetryReadingRepository : depends on protocol
TelemetryApplicationService --> IActuationEventRepository : depends on protocol
TelemetryApplicationService ..> TelemetryReading : creates through factory
TelemetryApplicationService ..> ActuationEvent : creates through factory
TelemetryApplicationService ..> DeviceAuthenticationFailed : raises
TelemetryApplicationService ..> DeviceTypeNotAllowed : raises

EnvironmentalProfileApplicationService --> IamAntiCorruptionLayer
EnvironmentalProfileApplicationService --> IEnvironmentalProfileRepository
EnvironmentalProfileApplicationService ..> ConfigurationNotAvailable : raises

SyncIamAntiCorruptionLayer --> AuthApplicationService : lists the nodes through
DeviceRegistryApplicationService --> IDeviceRegistryGateway
DeviceRegistryApplicationService --> SyncIamAntiCorruptionLayer : keeps only the nodes of this Edge
DeviceRegistryApplicationService --> IMonitoredDeviceRepository
ProfileSynchronizationApplicationService --> IProfileGateway
ProfileSynchronizationApplicationService --> IMonitoredDeviceRepository : reads the placed nodes
ProfileSynchronizationApplicationService --> IEnvironmentalProfileRepository : replaces the copy of Tracking
TelemetrySynchronizationApplicationService --> ITelemetryGateway
TelemetrySynchronizationApplicationService --> IMonitoredDeviceRepository : routes by node
TelemetrySynchronizationApplicationService --> ITelemetryReadingRepository : sends the pending of Tracking
TelemetrySynchronizationApplicationService --> IActuationEventRepository : sends the pending of Tracking
MonitoredDeviceRepositoryImpl ..|> IMonitoredDeviceRepository
MonitoredDeviceRepositoryImpl --> MonitoredDeviceModel
MonitoredDeviceModel --> db
cloud_cli --> DeviceRegistryApplicationService : invokes
sync_api --> DeviceRegistryApplicationService : enrolls through
cloud_cli --> ProfileSynchronizationApplicationService : invokes
cloud_cli --> EnvironmentalProfileApplicationService : lists the profiles
cloud_cli --> TelemetrySynchronizationApplicationService : invokes

TelemetryReadingRepositoryImpl ..|> ITelemetryReadingRepository
TelemetryReadingRepositoryImpl --> TelemetryReadingModel
TelemetryReadingRepositoryImpl ..> TelemetryConflict : raises
ActuationEventRepositoryImpl ..|> IActuationEventRepository
ActuationEventRepositoryImpl --> ActuationEventModel
ActuationEventRepositoryImpl ..> TelemetryConflict : raises
EnvironmentalProfileRepositoryImpl ..|> IEnvironmentalProfileRepository
EnvironmentalProfileRepositoryImpl --> EnvironmentalProfileModel

CloudDeviceRegistryGateway ..|> IDeviceRegistryGateway
CloudProfileGateway ..|> IProfileGateway
CloudTelemetryGateway ..|> ITelemetryGateway
CloudDeviceRegistryGateway --> CloudSession
CloudProfileGateway --> CloudSession
CloudTelemetryGateway --> CloudSession
CloudSession ..> CloudRequestError : raises

tracking_api --> EnvironmentReadingRequest : validates
tracking_api --> ContainerReadingRequest : validates
tracking_api --> ActuationEventRequest : validates
tracking_api --> TelemetryApplicationService : invokes
tracking_api --> EnvironmentalProfileApplicationService : invokes

DeviceModel --> db
TelemetryReadingModel --> db
ActuationEventModel --> db
EnvironmentalProfileModel --> db
CloudSyncScheduler ..> db : one connection per task

create_app ..> AuthApplicationService : composes
create_app ..> IamAntiCorruptionLayer : composes
create_app ..> SyncIamAntiCorruptionLayer : composes
create_app ..> TelemetryApplicationService : composes
create_app ..> DeviceRegistryApplicationService : composes
create_app ..> EnvironmentalProfileApplicationService : composes
create_app ..> ProfileSynchronizationApplicationService : composes
create_app ..> TelemetrySynchronizationApplicationService : composes
create_app ..> CloudSession : composes when CLOUD_SYNC_ENABLED
create_app ..> CloudSyncScheduler : registry, profiles, telemetry
create_app ..> iam_api : registers
create_app ..> tracking_api : registers
create_app ..> sync_api : registers
create_app ..> devices_cli : registers
create_app ..> cloud_cli : registers
wsgi ..> create_app : starts cloud sync in the worker

note bottom of create_app
The database is configured and its tables are created at app creation.
The background synchronization starts only in the serving process
(python app.py or Gunicorn through wsgi.py), never in flask commands.
end note

@enduml
