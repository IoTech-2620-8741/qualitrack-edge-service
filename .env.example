# Copy this file to .env.development or .env.production and fill in the values.
# APP_ENV must match the file name: development or production.
# With Docker Compose, docker-compose.yml fixes APP_ENV, DEBUG, SEED_TEST_DEVICE,
# DATABASE_PATH, HOST and PORT for production; .env.production sets the rest.
APP_ENV=development
DEBUG=true
DATABASE_PATH=data/edge.db

# Development only: registers a test node on startup. Must be false in production.
# TEST_DEVICE_ID is the identifier the cloud registers for the node (sensorExternalId).
# Set a unique local-only TEST_DEVICE_API_KEY before enabling the seed.
SEED_TEST_DEVICE=false
TEST_DEVICE_ID=ENV-001
TEST_DEVICE_API_KEY=

# 0.0.0.0 lets the ESP32 nodes of the local network reach the Edge.
HOST=0.0.0.0
PORT=5000

# Connection with the QualiTrack Cloud REST API. The Edge authenticates as the
# Edge Gateway registered in the cloud (ADR-0014).
# CLOUD_DEVICE_ID must match the sensorExternalId of that Gateway.
# CLOUD_API_KEY is issued once by the cloud; keep it out of version control.
# Production requires https.
CLOUD_SYNC_ENABLED=false
CLOUD_API_URL=http://localhost:8080
CLOUD_DEVICE_ID=
CLOUD_API_KEY=
CLOUD_SYNC_INTERVAL_SECONDS=60

# Days the Edge keeps the readings and actions after the cloud accepted them
# (SYNCED) or refused them for good (REJECTED); then it deletes them. Pending
# records are never deleted. Both are optional: the defaults are 7 and 90 days.
SYNCED_RETENTION_DAYS=7
REJECTED_RETENTION_DAYS=90
