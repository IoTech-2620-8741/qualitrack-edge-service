# Copy this file to .env.development or .env.production and fill in the values.
# APP_ENV must match the file name: development or production.
APP_ENV=development
DEBUG=true
DATABASE_PATH=data/edge.db

# Development only: registers a test node on startup. Must be false in production.
# TEST_DEVICE_ID is the identifier the cloud registers for the node (sensorExternalId).
# Set a unique local-only TEST_DEVICE_API_KEY before enabling the seed.
SEED_TEST_DEVICE=false
TEST_DEVICE_ID=ENV-001
TEST_DEVICE_API_KEY=

# 0.0.0.0 lets the ESP32 nodes of the local network reach the Edge.
HOST=0.0.0.0
PORT=5000

# Connection with the QualiTrack Cloud REST API. The Edge signs in with the
# account of an operator of the laboratory, which must have changed its first
# password. Keep the password out of version control. Production requires https.
CLOUD_SYNC_ENABLED=false
CLOUD_API_URL=http://localhost:8080
CLOUD_USERNAME=
CLOUD_PASSWORD=
CLOUD_SYNC_INTERVAL_SECONDS=60
