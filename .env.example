# Copy this file to .env.development or .env.production and fill in the values.
# APP_ENV must match the file name: development or production.
APP_ENV=development
DEBUG=true
DATABASE_PATH=data/edge.db

# Development only: creates a test device on startup. Must be false in production.
SEED_TEST_DEVICE=true
TEST_DEVICE_ID=AA:BB:CC:DD:EE:FF
TEST_DEVICE_API_KEY=change-me

HOST=0.0.0.0
PORT=5000